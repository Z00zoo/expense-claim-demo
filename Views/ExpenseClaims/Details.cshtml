@model ExpenseClaim

@{
    ViewData["Title"] = "請款單明細";
    var canEdit = ExpenseClaimService.CanEdit(Model, int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0"), User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty);
    var canDelete = ExpenseClaimService.CanDelete(Model, int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0"), User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty);
    var canSubmit = ExpenseClaimService.CanSubmit(Model, int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0"), User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty);
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">請款單 @Model.ClaimNo</h1>
        <div class="text-muted">狀態：<span class="badge @Model.Status.ToBadgeClass()">@Model.Status.ToDisplayName()</span></div>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">返回清單</a>
</div>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

<dl class="row">
    <dt class="col-sm-2">申請人</dt>
    <dd class="col-sm-10">@Model.Applicant?.DisplayName</dd>

    <dt class="col-sm-2">請款日期</dt>
    <dd class="col-sm-10">@Model.ClaimDate.ToString("yyyy/MM/dd")</dd>

    <dt class="col-sm-2">金額</dt>
    <dd class="col-sm-10">@Model.Amount.ToString("N0")</dd>

    <dt class="col-sm-2">類別</dt>
    <dd class="col-sm-10">@Model.Category</dd>

    <dt class="col-sm-2">說明</dt>
    <dd class="col-sm-10">@Model.Description</dd>

    <dt class="col-sm-2">建立時間</dt>
    <dd class="col-sm-10">@Model.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</dd>

    <dt class="col-sm-2">更新時間</dt>
    <dd class="col-sm-10">@Model.UpdatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</dd>

    @if (Model.SubmittedAt.HasValue)
    {
        <dt class="col-sm-2">送出時間</dt>
        <dd class="col-sm-10">@Model.SubmittedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</dd>
    }
</dl>

<div class="d-flex gap-2">
    @if (canEdit)
    {
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">編輯</a>
    }

    @if (canSubmit)
    {
        <form asp-action="Submit" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-success">送出申請</button>
        </form>
    }

    @if (canDelete)
    {
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id">刪除</a>
    }
</div>

<hr class="my-4" />

<h2 class="h5">簽核紀錄</h2>
<partial name="_ApprovalRecords" model="Model.ApprovalRecords" />
