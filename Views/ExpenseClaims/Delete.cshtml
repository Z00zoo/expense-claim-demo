@model ExpenseClaim

@{
    ViewData["Title"] = "刪除請款";
}

<h1 class="h3 mb-3">刪除請款草稿</h1>

<div class="alert alert-warning">確定要刪除請款單 @Model.ClaimNo 嗎？此操作無法復原。</div>

<dl class="row">
    <dt class="col-sm-2">日期</dt>
    <dd class="col-sm-10">@Model.ClaimDate.ToDisplayDate()</dd>

    <dt class="col-sm-2">類別</dt>
    <dd class="col-sm-10">@Model.Category</dd>

    <dt class="col-sm-2">金額</dt>
    <dd class="col-sm-10">@Model.Amount.ToDisplayCurrency()</dd>
</dl>

<form asp-action="Delete" method="post" class="d-flex gap-2">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">刪除</button>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">取消</a>
</form>
