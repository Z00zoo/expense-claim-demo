@model IReadOnlyList<ExpenseClaim>

@{
    ViewData["Title"] = "待簽請款";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">待簽請款</h1>
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">回首頁</a>
</div>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-success">@message</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">目前沒有待處理請款單。</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead>
                <tr>
                    <th>單號</th>
                    <th>申請人</th>
                    <th>日期</th>
                    <th>類別</th>
                    <th class="text-end">金額</th>
                    <th>狀態</th>
                    <th class="text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in Model)
                {
                    <tr>
                        <td>@claim.ClaimNo</td>
                        <td>@claim.Applicant?.DisplayName</td>
                        <td>@claim.ClaimDate.ToDisplayDate()</td>
                        <td>@claim.Category</td>
                        <td class="text-end">@claim.Amount.ToDisplayCurrency()</td>
                        <td><span class="badge @claim.Status.ToBadgeClass()">@claim.Status.ToDisplayName()</span></td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-primary" asp-action="Review" asp-route-id="@claim.Id">處理</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
