@model ExpenseClaim

@{
    ViewData["Title"] = "簽核請款";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;
    var canApprove = ApprovalService.CanApprove(Model, role);
    var canReject = ApprovalService.CanReject(Model, role);
    var canMarkAsPaid = ApprovalService.CanMarkAsPaid(Model, role);
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">簽核請款 @Model.ClaimNo</h1>
        <div class="text-muted">狀態：<span class="badge @Model.Status.ToBadgeClass()">@Model.Status.ToDisplayName()</span></div>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Pending">返回待簽</a>
</div>

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<dl class="row">
    <dt class="col-sm-2">申請人</dt>
    <dd class="col-sm-10">@Model.Applicant?.DisplayName</dd>

    <dt class="col-sm-2">請款日期</dt>
    <dd class="col-sm-10">@Model.ClaimDate.ToDisplayDate()</dd>

    <dt class="col-sm-2">金額</dt>
    <dd class="col-sm-10">@Model.Amount.ToDisplayCurrency()</dd>

    <dt class="col-sm-2">類別</dt>
    <dd class="col-sm-10">@Model.Category</dd>

    <dt class="col-sm-2">說明</dt>
    <dd class="col-sm-10">@Model.Description</dd>
</dl>

<form method="post" class="col-lg-7">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input name="ExpenseClaimId" type="hidden" value="@Model.Id" />

    <div class="mb-3">
        <label for="Comment" class="form-label">備註</label>
        <textarea id="Comment" name="Comment" class="form-control" rows="4"></textarea>
        @if (canReject)
        {
            <div class="form-text">退回時必須填寫備註。</div>
        }
    </div>

    <div class="d-flex gap-2 mb-4">
        @if (canApprove)
        {
            <button type="submit" class="btn btn-success" asp-action="Approve">核准</button>
        }
        @if (canReject)
        {
            <button type="submit" class="btn btn-outline-danger" asp-action="Reject">退回</button>
        }
        @if (canMarkAsPaid)
        {
            <button type="submit" class="btn btn-primary" asp-action="MarkAsPaid">標記已付款</button>
        }
    </div>
</form>

<h2 class="h5">簽核紀錄</h2>
<partial name="_ApprovalRecords" model="Model.ApprovalRecords" />
